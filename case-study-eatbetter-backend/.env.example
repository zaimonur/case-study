# Application
APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=debug
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s

# Used when running the Go process directly on the host.
DATABASE_URL=postgres://eatbetter:eatbetter@localhost:5432/eatbetter?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME=30m
DB_PING_TIMEOUT=2s

# Docker Compose PostgreSQL settings.
POSTGRES_USER=eatbetter
POSTGRES_PASSWORD=eatbetter
POSTGRES_DB=eatbetter
POSTGRES_PORT=5432
